# =============================================================================
# NeuralCompile — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT commit your real .env file — it is git-ignored for security.
# =============================================================================

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Get your free Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Deployment ────────────────────────────────────────────────────────────────
# Override the backend API URL (leave blank for local auto-detection)
# API_URL=https://your-deployment-url.com

# ── App Behaviour ─────────────────────────────────────────────────────────────
# Set to "dev" for hot-reload or "prod" for optimised build
# REFLEX_ENV=dev

# ── Hugging Face Spaces (set automatically by HF — do not change) ────────────
# SPACE_ID=naveenrondla/Neural-Compile
# PORT=7860
